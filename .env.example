# PostgreSQL
POSTGRES_DB=speech_to_text
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend (Flask)
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO
UPLOAD_FOLDER=/app/uploads
NLTK_DATA=/usr/local/share/nltk_data

# Whisper / Hardware Acceleration
# options: auto | intel | cuda | cpu
WHISPER_DEVICE_PREFERENCE=auto
WHISPER_MODEL_SIZE=medium
WHISPER_CUDA_COMPUTE_TYPE=float16
OPENVINO_WHISPER_DIR=/app/models/openvino-whisper